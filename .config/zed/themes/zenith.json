{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Zenith",
  "author": "Zenith Shell",
  "themes": [
    {
      "name": "Zenith Dark",
      "appearance": "dark",
      "style": {
        "border": "#52443b",
        "border.variant": "#52443b",
        "border.focused": "#ffb785",
        "border.selected": "#ffb785",
        "border.transparent": "transparent",
        "elevated_surface.background": "#221a15",
        "surface.background": "#261e19",
        "background": "#140d08",
        "element.background": "#261e19",
        "element.hover": "#312822",
        "element.active": "#6e390c",
        "element.selected": "#6e390c",
        "element.disabled": "#52443b",
        "drop_target.background": "#312822",
        "ghost_element.hover": "#221a15",
        "ghost_element.active": "#261e19",
        "ghost_element.selected": "#6e390c",
        "text": "#f0dfd6",
        "text.muted": "#d7c3b7",
        "text.accent": "#ffb785",
        "text.disabled": "#9f8d83",
        "icon": "#f0dfd6",
        "icon.muted": "#d7c3b7",
        "icon.accent": "#ffb785",
        "status_bar.background": "#140d08",
        "title_bar.background": "#140d08",
        "toolbar.background": "#140d08",
        "tab_bar.background": "#140d08",
        "tab.inactive_background": "#140d08",
        "tab.active_background": "#261e19",
        "panel.background": "#221a15",
        "panel.focused_border": "#ffb785",
        "pane.focused_border": "#ffb785",
        "scrollbar_thumb.background": "#312822",
