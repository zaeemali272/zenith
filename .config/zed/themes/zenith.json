        "editor.line_number": "#9f8d83",
        "editor.active_line_number": "#ffb785",
        "terminal.background": "#140d08",
        "terminal.foreground": "#f0dfd6",
        "terminal.ansi.black": "#140d08",
        "terminal.ansi.red": "#ffb4ab",
        "terminal.ansi.green": "#c8ca94",
        "terminal.ansi.yellow": "#ffb785",
        "terminal.ansi.blue": "#e4bfa8",
        "terminal.ansi.magenta": "#ffb785",
        "terminal.ansi.cyan": "#e4bfa8",
        "terminal.ansi.white": "#f0dfd6",
        "terminal.ansi.bright_black": "#9f8d83",
        "terminal.ansi.bright_red": "#ffb4ab",
        "terminal.ansi.bright_green": "#c8ca94",
        "terminal.ansi.bright_yellow": "#ffb785",
        "terminal.ansi.bright_blue": "#e4bfa8",
        "terminal.ansi.bright_magenta": "#ffb785",
        "terminal.ansi.bright_cyan": "#e4bfa8",
        "terminal.ansi.bright_white": "#ffffff",
