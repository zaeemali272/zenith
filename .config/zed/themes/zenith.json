          "keyword": {
            "color": "#ffb785"
          },
          "number": {
            "color": "#c8ca94"
          },
          "operator": {
            "color": "#e4bfa8"
          },
          "property": {
            "color": "#f0dfd6"
          },
          "string": {
            "color": "#c8ca94"
          },
          "type": {
            "color": "#c8ca94"
          },
          "variable": {
            "color": "#f0dfd6"
